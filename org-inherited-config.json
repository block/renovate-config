{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "48 hours",
  "prCreation": "immediate",
  "extends": ["config:recommended", "group:allNonMajor", "schedule:earlyMondays", "helpers:pinGitHubActionDigests"],
  "packageRules": [
    {
      "description": "Hermit releases have no timestamps, so a required release age would hold their updates forever",
      "matchDatasources": ["hermit"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
